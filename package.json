{
  "name": "starfall-ruins",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "build:offline": "vite build --mode offline && node scripts/licenses.mjs && node scripts/offline.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": { "@playwright/test": "1.56.1", "tsx": "4.20.6", "typescript": "5.9.3", "vite": "7.1.12" }
}

